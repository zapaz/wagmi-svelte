{
  "name": "@zapaz/wagmi-svelte",
  "version": "0.2.0",
  "license": "MIT",
  "scripts": {
    "all": "pnpm run format && pnpm run check && pnpm run build",
    "format": "prettier --write --list-different .",
    "check": "pnpm run lint && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build && npm run package",
    "dev": "vite dev",
    "package": "svelte-kit sync && svelte-package -o 'dist/lib' && publint",
    "preview": "vite preview",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "prettier --check . && eslint ."
  },
  "files": [
    "package.json",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "svelte": "./dist/lib/index.js"
    },
    "./chains": {
      "types": "./dist/lib/chains/index.d.ts",
      "svelte": "./dist/lib/chains/index.js"
    },
    "./connectors": {
      "types": "./dist/lib/connectors/index.d.ts",
      "svelte": "./dist/lib/connectors/index.js"
    }
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.1.0",
    "@neoconfetti/svelte": "^2.2.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.7.3",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/svelte-query": "^5.59.16",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@wagmi/connectors": "^5.3.3",
    "@wagmi/core": "^2.14.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "mdsvex": "^0.12.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "publint": "^0.2.12",
    "svelte": "^5.1.3",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "viem": "^2.21.35",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "^20",
    "pnpm": "^9"
  }
}
